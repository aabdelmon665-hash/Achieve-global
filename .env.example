# ─────────────────────────────────────────────────────────────────────────────
# ACHIEVE GLOBAL website — environment variables
# Copy to .env.local for local development, and set the same variables in your
# hosting provider's dashboard for production. NEVER commit real values.
# See docs/EMAIL_SETUP.md for step-by-step instructions.
# ─────────────────────────────────────────────────────────────────────────────

# Email delivery provider: "resend" (recommended) or "smtp".
# "console" prints emails to the terminal and works in development only.
EMAIL_PROVIDER=

# Sender shown on notification emails. The domain must be verified with your
# provider (SPF/DKIM), e.g. "ACHIEVE GLOBAL Website <no-reply@achieveglobal.com.tr>"
EMAIL_FROM=

# Reply-To used on the optional acknowledgement email sent to visitors.
EMAIL_REPLY_TO=info@achieveglobal.com.tr

# Destination inboxes (defaults shown).
EMAIL_TO_GENERAL=info@achieveglobal.com.tr
EMAIL_TO_EXPORTS=exports@achieveglobal.com.tr
# Optional dedicated inbox for industrial sourcing; falls back to EMAIL_TO_GENERAL.
EMAIL_TO_SOURCING=

# Resend API key (only when EMAIL_PROVIDER=resend). Server-side only.
EMAIL_PROVIDER_API_KEY=

# SMTP settings (only when EMAIL_PROVIDER=smtp).
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Send an automatic "we received your inquiry" email to the visitor (true/false).
EMAIL_SEND_ACKNOWLEDGEMENT=false

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to run with no analytics and no cookie banner. When set, the
# script loads only after a visitor accepts analytics in the consent banner.
# Update the Cookie Policy to name the provider before enabling.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
